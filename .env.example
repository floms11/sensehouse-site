# ------------------------------------------------------------------
# Sense House — конфігурація середовища
# Скопіюйте у .env.local і заповніть реальними значеннями.
# Без каналу доставки заявок форма чесно повертатиме помилку 503.
# ------------------------------------------------------------------

# --- Доставка заявок (потрібен ОДИН з каналів) ---

# Варіант 1 (основний): CRM API з HMAC-підписом — специфікація в docs/lead-api.md
# LEAD_API_URL=https://crm.example.com/api/site-leads
# LEAD_API_KEY=            # openssl rand -hex 32
# LEAD_API_SECRET=         # openssl rand -hex 32 (окремий від key)

# Варіант 2: довільний webhook (Make, n8n, Zapier…), без підпису
# LEAD_WEBHOOK_URL=https://hooks.example.com/lead

# Варіант 3: Telegram-бот (заявки повідомленням у чат)
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=-1001234567890

# --- Аналітика (підключається лише за наявності ID) ---

# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_META_PIXEL_ID=000000000000000
